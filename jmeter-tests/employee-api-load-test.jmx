        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Convert Skills and Make Email Unique" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def skillsString = vars.get(&apos;skills&apos;)
skillsString = skillsString.replaceAll(&apos;^&quot;|&quot;$&apos;, &apos;&apos;)
def skillsList = skillsString.split(&apos;,&apos;).collect { &apos;&quot;&apos; + it.trim() + &apos;&quot;&apos; }
def skillsArray = &apos;[&apos; + skillsList.join(&apos;,&apos;) + &apos;]&apos;
vars.put(&apos;skillsArray&apos;, skillsArray)
def uniqueEmail = vars.get(&apos;email&apos;).replace(&apos;@&apos;, &apos;_&apos; + ctx.getThreadNum() + &apos;_&apos; + System.currentTimeMillis() + &apos;@&apos;)
vars.put(&apos;uniqueEmail&apos;, uniqueEmail)</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
