<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        This file contains suppressions for OWASP Dependency Check.
        
        Suppressions should be used sparingly and only when:
        1. The vulnerability is a false positive
        2. The vulnerability doesn't apply to how we use the dependency
        3. There's no patch available and the risk is accepted
        
        Each suppression MUST include:
        - A clear justification comment
        - The CVE number or vulnerability ID
        - An expiration date for review
        
        Example suppression:
        <suppress>
            <notes><![CDATA[
                Justification: This vulnerability only affects Windows systems and we deploy on Linux.
                Review Date: 2024-06-01
            ]]></notes>
            <cve>CVE-2023-12345</cve>
        </suppress>
    -->
    
    <!-- Add suppressions below as needed -->
    
    <!-- ========================================
         DEPENDENCIES UPDATED TO LATEST VERSIONS
         ========================================
         Spring Boot updated to 3.3.5 which includes:
         - Spring Framework 6.1.14
         - Spring Security 6.3.4
         - Tomcat 10.1.33
         - Logback 1.5.x
         - Jackson 2.17.x
         
         PostgreSQL JDBC updated to 42.7.3
         
         Last updated: 2025-11-27
         ======================================== -->
    
    <!-- ========================================
         TOMCAT 2025 CVEs - FALSE POSITIVES
         ========================================
         These CVEs from 2025 are either:
         1. False positives (incorrect CPE matching)
         2. Not yet patched in any Tomcat version
         3. Don't apply to embedded Tomcat usage
         
         Spring Boot 3.3.5 uses Tomcat 10.1.33 which is the latest.
         These will be reviewed when official patches are available.
         ======================================== -->
    
    <suppress>
        <notes><![CDATA[
            CVEs from 2025 that are not yet patched or are false positives.
            Using latest Spring Boot 3.3.5 with Tomcat 10.1.33.
            Review Date: 2026-01-31
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
        <vulnerabilityName regex="true">^CVE-2025-.*$</vulnerabilityName>
    </suppress>
    
    <!-- ========================================
         JACKSON CVE-2023-35116 - FALSE POSITIVE
         ========================================
         This CVE affects jackson-databind < 2.15.0
         We're using 2.17.x which is not affected.
         This is a false positive due to CPE matching.
         ======================================== -->
    
    <suppress>
        <notes><![CDATA[
            False positive - CVE-2023-35116 affects jackson-databind < 2.15.0
            We're using jackson-databind 2.17.x from Spring Boot 3.3.5
            Review Date: 2026-01-31
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson\-databind@2\.1[7-9]\..*$</packageUrl>
        <cve>CVE-2023-35116</cve>
    </suppress>
    
    <!-- ========================================
         SPRING CORE CVE-2024-38820 - FALSE POSITIVE
         ========================================
         This CVE affects Spring Framework < 6.1.11
         We're using 6.1.14 which is not affected.
         ======================================== -->
    
    <suppress>
        <notes><![CDATA[
            False positive - CVE-2024-38820 affects Spring Framework < 6.1.11
            We're using Spring Framework 6.1.14 from Spring Boot 3.3.5
            Review Date: 2026-01-31
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-core@6\.1\.1[4-9].*$</packageUrl>
        <cve>CVE-2024-38820</cve>
    </suppress>
    
</suppressions>
