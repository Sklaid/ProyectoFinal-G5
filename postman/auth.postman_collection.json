		{
			"name": "Login with Missing Credentials",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test status code",
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"// Test response time",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Test validation error response",
							"pm.test(\"Response indicates validation error\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('code');",
							"    pm.expect(jsonData.code).to.be.oneOf(['VALIDATION_ERROR', 'BAD_REQUEST']);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"\",\n    \"password\": \"\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "Test login with empty credentials. Should return 400 Bad Request with validation errors."
			},
			"response": []
		},
		{
			"name": "Logout with Valid Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test status code",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test response time",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Test response structure",
							"pm.test(\"Response has message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('message');",
							"});",
							"",
							"// Test success message",
							"pm.test(\"Logout message is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include('Logout');",
							"});",
							"",
							"// Clear token from environment",
							"pm.test(\"Clear token from environment\", function () {",
							"    pm.environment.unset(\"auth_token\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"token\": \"{{auth_token}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/logout",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"logout"
					]
				},
				"description": "Test logout with valid token. Should return 200 with success message."
			},
			"response": []
		}
	]
}
